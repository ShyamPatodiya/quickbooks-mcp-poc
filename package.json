{
  "name": "quickbooks-mcp-poc",
  "version": "0.1.0",
  "description": "Proof of concept MCP server for QuickBooks Online Sandbox",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "quickbooks-mcp-poc": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/quickbooks/auth/cli.ts",
    "lint": "eslint src tests",
    "test": "node --import tsx --test tests/unit/**/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "dotenv": "^16.4.7",
    "intuit-oauth": "^4.2.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
